{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "https://github.com/pirut/mc-mods",
    "sources": "https://github.com/pirut/mc-mods",
    "issues": "https://github.com/pirut/mc-mods/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.pirut.examplemod.fabric.ExampleModFabric"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
