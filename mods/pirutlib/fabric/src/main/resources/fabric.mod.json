{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "https://github.com/pirut/mc-mods/tree/main/mods/pirutlib",
    "sources": "https://github.com/pirut/mc-mods",
    "issues": "https://github.com/pirut/mc-mods/issues"
  },
  "icon": "assets/pirutlib/icon.png",
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.pirut.lib.fabric.PirutLibFabric"]
  },
  "mixins": ["pirutlib.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
