{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "https://github.com/pirut/mc-mods/tree/main/mods/cc-agent",
    "sources": "https://github.com/pirut/mc-mods/tree/main/mods/cc-agent",
    "issues": "https://github.com/pirut/mc-mods/issues"
  },
  "license": "${mod_license}",
  "icon": "assets/ccagent/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.pirut.ccagent.fabric.CCAgentFabric"],
    "client": ["io.github.pirut.ccagent.fabric.CCAgentFabricClient"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "computercraft": ">=${cc_version_min}",
    "java": ">=21"
  }
}
